{
    "id":"fvtt-wfrp2e",
    "title":"Warhammer Fantasy Roleplay 2nd Edition",
    "description":"Unofficial Foundry VTT system for WFRP2E",
    "version":"1.0.0",
    "compatibility":
    {
        "minimum":"13",
        "verified":"13"
    },

    "authors":
    [
        {
            "name":"Tarinor"
        },
        {
            "name":"justanothermage"
        }
    ],

    "media": [
    {
      "type": "setup",
      "url": "systems/fvtt-wfrp2e/assets/Warhammer_fantasy_roleplay_cover.jpg",
      "thumbnail": "systems/fvtt-wfrp2e/assets/Warhammer_fantasy_roleplay_cover.jpg"
    }
    ],

    "esmodules": ["modules/wfrp2e.mjs"],
    "styles": ["styles/main.css"],

    "languages":
    [   
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        }
    ],

    "documentTypes": {
        "Actor": {
            "character": {
                "htmlFields": ["biography"],
                "filePathFields": {
                    "crest": ["IMAGE"]
                }
            }
        },
        "Item": {
            "career": {},
            "weapon": {},
            "armour": {},
            "spell": {},
            "talent": {},
            "mutation": {},
            "insanity": {},
            "equipment": {}
        }
    },

    "packs": [
        {
            "name": "beastiary",
            "label": "WFRP2E Beastiary",
            "type": "Actor",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        },

        {
            "name": "careers",
            "label": "WFRP2E Careers",
            "path": "packs/careers.db",
            "type": "Item",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        },
        {
            "name": "equipment",
            "label": "WFRP2E Equipment",
            "path": "packs/equipment.db",
            "type": "Item",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        },
        {
            "name": "talents",
            "label": "WFRP2E Talents",
            "path": "packs/talents.db",
            "type": "Item",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        },
                {
            "name": "spells",
            "label": "WFRP2E Spells",
            "path": "packs/spells.db",
            "type": "Item",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        },
        {
            "name": "Rollable Tables",
            "label": "WFRP2E Rollable Tables",
            "path": "packs/rollable-tables.db",
            "type": "RollTable",
            "ownership": {
                "PLAYER": "OBSERVER"
            }
        }
    ],
    "packFolders": [
        {
            "name": "WFRP2E Content",
            "sorting": "a",
            "packs": ["beastiary", "careers", "equipment", "talents", "spells", "Rollable Tables"]
        }
    ],
    "socket": true,
    "manifest": "Replace this with a link to the /latest release system.json",
    "download": "link to a .zip file of the current version",
    "background": "systems/fvtt-wfrp2e/assets/Warhammer_fantasy_roleplay_cover.jpg",
    
    "grid":
    {
        "gridDistance": 2,
        "gridUnits": "yards"
    },

    "primaryTokenAttribute": "system.secondary.wounds.value"
}